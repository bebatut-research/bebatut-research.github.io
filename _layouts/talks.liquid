---
layout: default
---
{% assign date_format = site.date_format | default: '%b %-d, %Y' %}
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}

    {% assign years = '' | split: '' %}
    {% for entry in site.data.talks.talks %}
      {% assign years = years | push: entry[0] %}
    {% endfor %}
    {% assign years = years | sort | reverse %}
    {% for year in years %}
      {% assign year_talks = site.data.talks.talks[year] %}
      {% unless year_talks %}{% continue %}{% endunless %}
      {% assign talks = year_talks | sort: 'event.date' | reverse %}
      <h2 id="{{ year }}">{{ year }}</h2>
      <div class="table-responsive">
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Date</th>
              <th>Title</th>
              <th>Duration</th>
              <th>Event</th>
              <th>Location</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>
            {% for item in talks %}
              <tr>
                <td>
                  <span class="text-nowrap">{{ item.event.date | date: date_format }}</span>
                </td>
                <td>
                  {% capture title_html %}{{ item.talk.title | markdownify | remove: '<p>' | remove: '</p>' }}{% endcapture %}
                  {% if item.talk.link %}
                    <a href="{{ item.talk.link }}">{{ title_html }}</a>
                  {% else %}
                    {{ title_html }}
                  {% endif %}
                </td>
                <td>
                  <span class="text-nowrap">{{ item.talk.duration }}</span>
                </td>
                <td>
                  {% if item.event.link %}
                    <a href="{{ item.event.link }}">{{ item.event.name }}</a>
                  {% else %}
                    {{ item.event.name }}
                  {% endif %}
                </td>
                <td>
                  {% if item.event.location.city %}{{ item.event.location.city }}, {% endif %}
                  {{- item.event.location.country -}}
                </td>
                <td>
                  {% if item.talk.source %}
                    <a href="{{ item.talk.source }}"><i class="fab fa-github"></i></a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endfor %}
  </article>
</div>
